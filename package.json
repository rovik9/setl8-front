{
  "name": "setl8-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.2 <23",
    "npm": ">=10.9.8 <11"
  },
  "scripts": {
    "shots": "node tools/capture-btp-screens.mjs",
    "dev": "node tools/development.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:integration": "node tools/backend-smoke.mjs",
    "format": "prettier --write src tests tools docs README.md *.ts *.json index.html",
    "format:check": "prettier --check src tests tools docs README.md *.ts *.json index.html",
    "verify:sdk": "node tools/verify-order-sdk.mjs",
    "gen:devnet-proof": "node tools/gen-devnet-proof.mjs",
    "verify:devnet-proof": "node tools/gen-devnet-proof.mjs --check",
    "prebuild": "npm run verify:sdk && npm run verify:p30",
    "pretest": "npm run verify:sdk && npm run verify:p30",
    "predev": "npm run verify:sdk && npm run verify:p30",
    "prototype": "node tools/prototype-session.mjs start",
    "prototype:stop": "node tools/prototype-session.mjs stop",
    "prototype:status": "node tools/prototype-session.mjs status",
    "verify:p30": "node tools/verify-p30-sdk.mjs",
    "dev:web": "node tools/development.mjs web",
    "dev:status": "node tools/development.mjs status",
    "dev:legacy": "node tools/development.mjs legacy"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@setl8/order-codec": "file:packages/setl8-order-codec",
    "@setl8/p30-sdk": "file:dependencies/p30/3e33090cf9193fd909f57ed75e10f9e59b9409e3c8a8f6c186272d8ee185f86d/setl8-sdk-0.1.0-dev.5.tgz",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "lightweight-charts": "5.2.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "bs58": "6.0.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
